<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tepi.Linux.UI.IslandWindow"
        Title="Tepi Dynamic Island"
        Width="152" Height="44"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2,4,2,4">
        <!-- Island Capsule -->
        <Border Name="IslandBorder"
                Background="#E6101014"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                BoxShadow="0 4 20 0 #A0000000"
                ClipToBounds="True"
                Cursor="Hand"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed">
            
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut" />
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>

            <Grid Margin="12,6,12,6">
                <!-- 1. IDLE / COMPACT VIEW -->
                <Grid Name="IdleView" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- Left: Mini Mascot / Indicator -->
                    <TextBlock Name="MascotText" Grid.Column="0" Text="●" Foreground="#3B82F6" 
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    
                    <!-- Center: Clock / Status -->
                    <TextBlock Name="ClockText" Grid.Column="1" Text="12:00" Foreground="#F3F4F6" 
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    
                    <!-- Right: Playing wave / info -->
                    <TextBlock Name="StatusGlyph" Grid.Column="2" Text="♫" Foreground="#9CA3AF" 
                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <!-- 2. EXPANDED VIEW CONTAINER -->
                <StackPanel Name="ExpandedView" IsVisible="False" Spacing="10" VerticalAlignment="Top">
                    <!-- Header with Title & Close/Minimize -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Name="ViewCategoryText" Text="Tepi Island" Foreground="#9CA3AF" FontSize="11" FontWeight="Medium" />
                            <TextBlock Text="•" Foreground="#4B5563" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Name="SubInfoText" Text="Linux ARM64" Foreground="#60A5FA" FontSize="11" />
                        </StackPanel>
                        
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="4,0,4,0" 
                                Foreground="#6B7280" Click="OnMinimizeClick" Cursor="Hand">
                            <TextBlock Text="▲" FontSize="10" />
                        </Button>
                    </Grid>

                    <!-- A. Media Section -->
                    <Border Name="MediaSection" Background="#1AFFFFFF" CornerRadius="12" Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <!-- Album art placeholder / Icon -->
                            <Border Grid.RowSpan="2" Width="36" Height="36" Background="#33333E" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="♫" FontSize="18" Foreground="#E5E7EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title & Artist -->
                            <TextBlock Name="TrackTitle" Grid.Column="1" Grid.Row="0" Text="Tidak ada musik" 
                                       Foreground="#F9FAFB" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Name="TrackArtist" Grid.Column="1" Grid.Row="1" Text="Buka pemutar musik di Linux" 
                                       Foreground="#9CA3AF" FontSize="11" TextTrimming="CharacterEllipsis"/>

                            <!-- Controls -->
                            <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Background="Transparent" Foreground="#D1D5DB" Padding="6,4" Click="OnPrevTrackClick">
                                    <TextBlock Text="⏮" FontSize="12"/>
                                </Button>
                                <Button Name="PlayPauseBtn" Background="#3B82F6" Foreground="White" CornerRadius="14" Padding="8,4" Click="OnPlayPauseClick">
                                    <TextBlock Name="PlayPauseIcon" Text="▶" FontSize="11"/>
                                </Button>
                                <Button Background="Transparent" Foreground="#D1D5DB" Padding="6,4" Click="OnNextTrackClick">
                                    <TextBlock Text="⏭" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- B. Agent Section (Visible when active) -->
                    <Border Name="AgentSection" Background="#153B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="12" Padding="10,8" IsVisible="False">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⚡ Coding Agent" Foreground="#60A5FA" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Name="AgentNameText" Text="Antigravity" Foreground="#93C5FD" FontSize="11"/>
                            </StackPanel>
                            <TextBlock Name="AgentPromptText" Grid.Row="1" Text="Menjalankan tugas..." 
                                       Foreground="#E5E7EB" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>
                            <StackPanel Name="AgentActions" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Content="Tolak" Background="#374151" Foreground="#F87171" FontSize="11" Padding="10,4" CornerRadius="8" Click="OnAgentRejectClick"/>
                                <Button Content="Izinkan" Background="#2563EB" Foreground="White" FontSize="11" Padding="10,4" CornerRadius="8" Click="OnAgentApproveClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- C. Sholat & Productivity Row -->
                    <Grid ColumnDefinitions="*,*" Margin="2,0,2,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🕌" FontSize="12"/>
                            <TextBlock Name="PrayerText" Text="Subuh 04:30" Foreground="#D1D5DB" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Background="Transparent" Padding="4,2" Foreground="#9CA3AF" Click="OnTimerToggleClick">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="⏱" FontSize="11"/>
                                    <TextBlock Name="TimerBtnText" Text="Timer" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Background="Transparent" Padding="4,2" Foreground="#EF4444" Click="OnExitClick">
                                <TextBlock Text="Keluar" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
